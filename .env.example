# Copy this file to `.env` and fill in values when integrations are implemented.
# Do not commit `.env` — it is listed in `.gitignore`.

# --- Slack (alerts) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- X (Twitter) ---
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- Pond ---
POND_API_KEY=
POND_API_URL=

# --- Application ---
# Path to local SQLite database for persistent state (optional override)
STATE_DB_PATH=./data/state.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- YC Directory (optional overrides) ---
# If unset, the monitor extracts the public Algolia search key from the YC companies page.
YC_COMPANIES_URL=https://www.ycombinator.com/companies
YC_ALGOLIA_APP_ID=
YC_ALGOLIA_API_KEY=
YC_ALGOLIA_INDEX=YCCompany_production
YC_ALGOLIA_HITS_PER_PAGE=1000
